# Copy to `.env.local` for local dev. This file is safe to commit — use placeholders only.
# Real keys must never be committed (see `.gitignore`: `.env` / `.env.*` are ignored, not `.env.example`).

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Never commit real keys. Use different projects for production vs local/staging.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only: bypasses RLS. Used by admin client for audited server actions (tasks, notifications, audit).
# NEVER prefix with NEXT_PUBLIC_. Never import in client components.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Rate limiting (required for production-style deploys) ─────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ─── Vercel Cron (optional) ──────────────────────────────────────────────────
# Authorization: Bearer <CRON_SECRET> or ?secret=<CRON_SECRET> for /api/cron/* routes.
# CRON_SECRET=generate-a-long-random-string

# Public site URL for absolute links in emails (digest, transactional). Vercel sets VERCEL_URL automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Stripe (club dues — Checkout + webhook) ─────────────────────────────
# TEST MODE ONLY: the app refuses any key that is not sk_test_ / rk_test_.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Use Stripe CLI locally: stripe listen --forward-to localhost:3000/api/stripe/webhook

# ─── Transactional email (Resend) — optional; without a key, sends are skipped (logged). ───
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="Clubora <notifications@yourdomain.com>"

# ─── Demo site (scripts/seed-demo/run.ts, landing-page one-click sign-in) ─────
# Server-only. NEVER prefix with NEXT_PUBLIC_. Emails must end with @demo.clubora.test.
# The landing page "Try as officer / member" buttons sign in with these; `npm run reset-demo`
# (re)creates the accounts with them.
DEMO_OFFICER_EMAIL=officer@demo.clubora.test
DEMO_OFFICER_PASSWORD=choose-a-long-random-password
DEMO_MEMBER_EMAIL=member@demo.clubora.test
DEMO_MEMBER_PASSWORD=choose-a-different-long-random-password

# `npm run reset-demo` deletes EVERY user and club on the target project. It refuses to run
# unless NEXT_PUBLIC_SUPABASE_URL belongs to this project ref.
# DEMO_SUPABASE_PROJECT_REF=your-project-ref

# Required to run reset-demo when NODE_ENV=production or VERCEL_ENV=production
# ALLOW_DEMO_SEED=true
